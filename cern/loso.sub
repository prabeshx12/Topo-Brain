# ============================================================================
# loso.sub -- submit ALL 10 leave-one-subject-out folds at once.
# `queue 10` launches 10 jobs; $(ProcId) = 0..9 = the FOLD index, so one
# condor_submit runs the whole cross-validation -- 10 GPUs in parallel.
#
# SUBMIT FROM AFS, NOT /eos (the schedd rejects /eos submit-file paths):
#   mkdir -p ~/loso_submit/logs
#   cp /eos/user/p/ppokhrel/topobrain/Topo-Brain/cern/run_loso_fold.sh ~/loso_submit/
#   cp /eos/user/p/ppokhrel/topobrain/Topo-Brain/cern/loso.sub        ~/loso_submit/
#   chmod +x ~/loso_submit/run_loso_fold.sh
#   cd ~/loso_submit && condor_submit loso.sub
#
# args = FOLD  N_ITERS  LAM_TOPO.  LAM_TOPO=0 here = the BASELINE (no topology) sweep.
# For the topology method, change the last arg (e.g. 0.1) AND the output dir is kept
# separate automatically (runs/loso_topo0 vs runs/loso_topo0.1).
# HTCondor does NOT allow inline '#' after a value -- keep comments on their own lines.
# ============================================================================
executable   = run_loso_fold.sh
arguments    = $(ProcId) 40000 0

output       = logs/loso.$(ClusterId).$(ProcId).out
error        = logs/loso.$(ClusterId).$(ProcId).err
log          = logs/loso.$(ClusterId).log

request_gpus   = 1
request_cpus   = 4
request_memory = 16 GB

# stream logs live (default transfers only at job end)
stream_output = True
stream_error  = True

# espresso=20m microcentury=1h longlunch=2h workday=8h tomorrow=1d testmatch=3d
+JobFlavour  = "tomorrow"

queue 10
