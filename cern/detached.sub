# ============================================================================
# detached.sub -- submit the detached-head (dose-response) training to HTCondor.
#
# SUBMIT FROM AFS, NOT /eos (the schedd rejects /eos submit-file paths):
#   cd /eos/user/p/ppokhrel/topobrain/Topo-Brain && git pull
#   mkdir -p ~/detached_submit/logs
#   cp /eos/user/p/ppokhrel/topobrain/Topo-Brain/cern/run_detached.sh ~/detached_submit/
#   cp /eos/user/p/ppokhrel/topobrain/Topo-Brain/cern/detached.sub    ~/detached_submit/
#   chmod +x ~/detached_submit/run_detached.sh
#   cd ~/detached_submit && condor_submit detached.sub
#   condor_q                       (Idle -> Running -> gone = done)
#   tail -f ~/detached_submit/logs/detached.*.out
#
# HTCondor does NOT allow inline '#' after a value -- keep comments on their own lines.
# ============================================================================
executable   = run_detached.sh

output       = logs/detached.$(ClusterId).$(ProcId).out
error        = logs/detached.$(ClusterId).$(ProcId).err
log          = logs/detached.$(ClusterId).log

request_gpus   = 1
request_cpus   = 4
request_memory = 16 GB

stream_output = True
stream_error  = True

# espresso=20m microcentury=1h longlunch=2h workday=8h tomorrow=1d testmatch=3d
+JobFlavour  = "tomorrow"

queue 1
