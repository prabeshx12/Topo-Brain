# ============================================================================
# topo.sub -- submit the Phase 3 (clean segs) training to HTCondor.
#   condor_submit topo.sub
#   condor_q                    # Idle -> Running -> (gone = done)
#   tail -f logs/topo.*.out     # live log once Running
# ============================================================================
executable   = run_job.sh

output       = logs/topo.$(ClusterId).$(ProcId).out
error        = logs/topo.$(ClusterId).$(ProcId).err
log          = logs/topo.$(ClusterId).log

request_gpus   = 1
request_cpus   = 4          # dataloader workers -- the old bottleneck was CPU, not GPU
request_memory = 16 GB

# CERN walltime flavour: espresso=20m microcentury=1h longlunch=2h workday=8h
# tomorrow=1d testmatch=3d.  Training has --max-hours 20 + checkpointing, so "tomorrow".
+JobFlavour  = "tomorrow"

# To request an A100 specifically, add the line your friend gives you, e.g.:
# require_gpus = DeviceName == "NVIDIA A100"

queue 1
