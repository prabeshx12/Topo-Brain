# ============================================================================
# topo.sub -- submit the Phase 3 (clean segs) training to HTCondor.
#   condor_submit topo.sub
#   condor_q                    (Idle -> Running -> gone = done)
#   tail -f logs/topo.*.out     (live log once Running)
#
# NOTE: HTCondor does NOT allow inline '#' comments after a value on the same
# line -- it parses the rest of the line as the expression. Keep comments on
# their own lines.
# ============================================================================
executable   = run_job.sh

output       = logs/topo.$(ClusterId).$(ProcId).out
error        = logs/topo.$(ClusterId).$(ProcId).err
log          = logs/topo.$(ClusterId).log

request_gpus   = 1
request_cpus   = 4
request_memory = 16 GB

# NOTE: stream_output/stream_error were REMOVED -- CERN disabled live streaming end-Nov-2025
# (schedd/filesystem load). The .out/.err transfer only at job end. To watch progress live, read
# the trainer's train_history.json on EOS (flushed every log step) or ls the checkpoints dir.
#
# CERN walltime flavours: espresso=20m microcentury=1h longlunch=2h workday=8h tomorrow=1d testmatch=3d
+JobFlavour  = "tomorrow"

# To request an A100 specifically, add the line your friend gives you, e.g.:
# require_gpus = DeviceName == "NVIDIA A100"

queue 1
